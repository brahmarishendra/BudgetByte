# Render Production Environment Variables
# Add these as secrets in your Render Dashboard: Settings > Environment

# Database
POSTGRES_DB=budgetbyte
POSTGRES_USER=budgetuser
POSTGRES_PASSWORD=your_secure_password_here

# Backend/Spring Boot
SPRING_DATASOURCE_URL=postgresql://budgetbyte-db:5432/budgetbyte
SPRING_DATASOURCE_USERNAME=budgetuser
SPRING_DATASOURCE_PASSWORD=your_secure_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_PROFILES_ACTIVE=prod

# Frontend
BACKEND_URL=https://budgetbyte-backend.onrender.com
VITE_API_URL=https://budgetbyte-backend.onrender.com/api

# Optional: CORS & Security
SERVER_SERVLET_CONTEXT_PATH=/
CORS_ALLOWED_ORIGINS=https://budgetbyte-frontend.onrender.com
