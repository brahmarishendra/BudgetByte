# Render Frontend Environment Variables
# Copy these values into Render Dashboard → Environment tab for budgetbyte-frontend service

VITE_API_URL=https://budgetbyte.onrender.com/api
VITE_API_BASE_URL=https://budgetbyte.onrender.com
VITE_API_TIMEOUT=30000

# RUNTIME and ENVIRONMENT
NODE_ENV=production
NPM_FLAGS=--legacy-peer-deps

# DEBUG & LOGGING 
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# aPP CONFIGURATION 
VITE_APP_TITLE=Budget Byte
VITE_APP_DESCRIPTION=Personal Budget Tracking Application

#Features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
# NEON AUTHENTICATION & JWKS
VITE_NEON_AUTH_URL=https://ep-hidden-flower-b5nzmrqw.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
VITE_NEON_JWKS_URL=https://ep-hidden-flower-b5nzmrqw.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

#  BUILD & DEPLOYMENT SETTINGS
# Root Directory: Frontend/Budget Tracking APP UI
# Build Command: npm ci && npm run build
# Publish Directory: dist
# Port: 80
