# Budget Byte Frontend - Production Environment Variables for Render

# ===== API CONFIGURATION =====
VITE_API_URL=https://budgetbyte.onrender.com/api
VITE_API_BASE_URL=https://budgetbyte.onrender.com
VITE_API_TIMEOUT=30000

# ===== NODE ENVIRONMENT =====
NODE_ENV=production

# ===== DEBUG & LOGGING =====
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# ===== RUNTIME =====
VITE_APP_TITLE=Budget Byte
VITE_APP_DESCRIPTION=Personal Budget Tracking Application

# ===== FEATURES & FLAGS =====
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_DARK_MODE=true

# ===== SECURITY =====
# CORS is handled by backend, frontend uses relative/absolute API URLs

# ===== OPTIONAL: THIRD-PARTY SERVICES =====
# Add if using authentication, analytics, or error tracking:
# VITE_AUTH_URL=
# VITE_SENTRY_DSN=
# VITE_GOOGLE_ANALYTICS_ID=
