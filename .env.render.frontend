# Render Frontend Environment Variables
# Add these to your Frontend service in Render Dashboard → Environment

# Backend API URL (public)
VITE_API_URL=https://budgetbyte-backend.onrender.com/api

# Backend base URL
BACKEND_URL=https://budgetbyte-backend.onrender.com

# Optional: API timeout (milliseconds)
VITE_API_TIMEOUT=30000

# Optional: Enable debug logging
VITE_DEBUG=false

# Optional: Node environment
NODE_ENV=production
